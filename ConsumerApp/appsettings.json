{
    "EventHubs": {
        "ConnectionString": "<PLACEHOLDER_TOBEUPDATED>",
        "EventHubName": "myeventhub",
        "ConsumerGroup": "$Default"
    },
    "BlobStorage": {
        "ConnectionString": "<PLACEHOLDER_TOBEUPDATED>",
        "ContainerName": "eventhubsampleappcontainer"
    },
    "ServiceBus": {
        "ConnectionString": "<SERVICE_BUS_CONNECTION_STRING>",
        "DlqQueueName": "eventhub-dlq"
    },
    "Redis": {
        "ConnectionString": "<REDIS_CONNECTION_STRING>",
        "ProcessedKeyPrefix": "processed:"
    },
    "Processing": {
        "MaxRetryAttempts": 3,
        "RetryInitialDelayMs": 500,
        "BatchSize": 10
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft": "Warning",
            "System": "Warning"
        }
    }
}